# Copy to a protected deployment environment file; never commit populated secrets.
POSTGRES_DB=sonoran_ops
POSTGRES_USER=sonoran
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_URL_SAFE_RANDOM_VALUE

# Loopback-only operator checks. Public traffic uses the external sonoran_edge network.
SONORAN_WEB_PORT=3211
SONORAN_API_PORT=3212

# Embedded in the browser bundle during image build.
NEXT_PUBLIC_BASE_PATH=/portfolio/sonoran-ops
NEXT_PUBLIC_API_BASE_URL=/portfolio/sonoran-ops
NEXT_PUBLIC_READ_ONLY_MODE=true
CORS_ORIGINS=https://matthewflorek.com

# Used only by the opt-in seed profile.
DEMO_SEED=17
DEMO_MINUTES=180
DEMO_WALLCLOCK_SPAN_MINUTES=4
