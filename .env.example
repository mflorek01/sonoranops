# Local development only. Do not commit a populated .env file.
POSTGRES_DB=sonoran_ops
POSTGRES_USER=sonoran
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000
MQTT_PORT=1883

# Used by host-run API commands. Compose supplies an internal database URL to the API container.
DATABASE_URL=postgresql+psycopg://sonoran:change-me@localhost:5432/sonoran_ops
AUTO_CREATE_SCHEMA=false
CORS_ORIGINS=http://localhost:3000

# Public browser configuration; it is embedded when the Next.js image is built.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=false

# Optional server-only evidence chat. Leave OPENAI_API_KEY empty to keep chat disabled.
# Never put a real key in this file or in any NEXT_PUBLIC_* variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Required whenever production chat is deployed. Generate a unique random value;
# do not reuse the development default or commit the generated value.
CHAT_SAFETY_SALT=
