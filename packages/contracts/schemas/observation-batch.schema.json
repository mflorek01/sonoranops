{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonoran-ops.dev/contracts/observation-batch/1.0.schema.json",
  "title": "Observed input batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "source", "observations"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "received_via"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_type": {"enum": ["telemetry", "file", "external_api"]},
        "received_via": {"enum": ["api", "file_adapter", "external_adapter"]}
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "$defs": {
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_id", "asset_id"],
      "properties": {
        "site_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "asset_id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency_key", "observed_at", "asset_ref", "kind", "source_recorded_at"],
      "properties": {
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 255},
        "observed_at": {"type": "string", "format": "date-time"},
        "asset_ref": {"$ref": "#/$defs/assetRef"},
        "kind": {"enum": ["telemetry", "production_record", "quality_result", "maintenance_record", "dispatch_record", "environmental_observation"]},
        "metric": {"type": "string", "maxLength": 128},
        "value": {"type": "number"},
        "unit": {"type": "string", "maxLength": 32},
        "record_type": {"type": "string", "maxLength": 128},
        "source_recorded_at": {"type": "string", "format": "date-time"},
        "attributes": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "telemetry"}}},
          "then": {"required": ["metric", "value", "unit"]}
        },
        {
          "if": {"properties": {"kind": {"not": {"const": "telemetry"}}}},
          "then": {"anyOf": [{"required": ["record_type"]}, {"required": ["metric"]}]}
        }
      ]
    }
  }
}
